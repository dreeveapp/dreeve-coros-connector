{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>xballoy/renovate-config"],
  "constraints": {
    "ghActionsLock": "v0.4.1"
  },
  "postUpdateOptions": ["gomodTidy"],
  "packageRules": [
    {
      "matchManagers": ["gomod"],
      "matchDepNames": ["go"],
      "matchDepTypes": ["golang"],
      "rangeStrategy": "bump"
    },
    {
      "groupName": "Go toolchain",
      "matchDepNames": ["go", "golang"]
    },
    {
      "groupName": "gh-actions-lock",
      "matchDepNames": ["github/gh-actions-lock"]
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "gh-actions-lock extension installed by CI",
      "managerFilePatterns": ["/^\\.github/workflows/[^/]+\\.ya?ml$/"],
      "matchStrings": ["gh extension install github/gh-actions-lock --pin (?<currentValue>v\\S+)"],
      "depNameTemplate": "github/gh-actions-lock",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "gh-actions-lock extension Renovate uses to regenerate actions.lock",
      "managerFilePatterns": ["/^renovate\\.json$/"],
      "matchStrings": ["\"ghActionsLock\": \"(?<currentValue>v[^\"]+)\""],
      "depNameTemplate": "github/gh-actions-lock",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "Dreeve commit whose fit-tool the oracle test builds",
      "managerFilePatterns": ["/^testdata/dreeve/fit-tool\\.json$/"],
      "matchStrings": ["\"commit\": \"(?<currentDigest>[0-9a-f]{40})\""],
      "currentValueTemplate": "master",
      "depNameTemplate": "dreeveapp/dreeve",
      "packageNameTemplate": "https://github.com/dreeveapp/dreeve",
      "datasourceTemplate": "git-refs"
    }
  ]
}
